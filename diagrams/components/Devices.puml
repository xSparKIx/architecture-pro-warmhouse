@startuml Devices component diagram
title Диаграмма компонентов управления устройств

!include ../templates/C4_Component.puml

' Внешние сущности
Container(APIGateway, "API Gateway", "GoLang 1.22", "Обрабатывает запросы пользователей")
ContainerDb(db, "База данных", "PostgreSql 16", "Хранит информацию об устройствах, функционале устройств, модулях и их связках")
Container(broker, "Брокер сообщений", "Kafka", "Хранит информацию о переданных командах устройствам")
Container_Ext(UserDevicesSystem, "Устройства умного дома пользователя")

' Контейнер администрирования устройств
Container_Boundary(DevicesContainer, "Администрирование устройств") {
    ' Управление устройствами
    Component(DevicesController, "Контроллер управления устройствами", "NestJS Rest Controller")
    Component(DevicesService, "Сервис управления устройствами", "NestJS")
    Component(DevicesComponent, "Компонент управления устройствами", "NestJS")

    ' Администрирование устройств
    Component(FunctionalController, "Контроллер управления функционалом устройства", "NestJS Rest Controller")
    Component(FunctionalConsumer, "Потребитель (Consumer) управления функционалом устройства", "NestJS Rest Controller", "Обрабатывает события вызова функционала устройств")
    Component(FunctionalService,  "Сервис управления функционалом устройства", "NestJS")
    Component(FunctionalComponent,  "Компонент управления функционалом устройства", "NestJS")
}

' Контейнер администрирования модулей
Container_Boundary(ModulesContainer, "Администрирование модулей") {
    ' Управление устройствами
    Component(ModulesController, "Контроллер управления модулями", "NestJS Rest Controller")
    Component(ModulesService, "Сервис управления модулями", "NestJS")
    Component(ModulesComponent, "Компонент управления модулями", "NestJS")

    ' Привязка устройств к модулям
    Component(ModulesConnectController, "Контроллер привязки устройств к модулям", "NestJS Rest Controller")
    Component(ModulesConnectService, "Сервис привязки устройств к модулям", "NestJS")
    Component(ModulesConnectComponent, "Компонент привязки устройств к модулям", "NestJS")
}

' Связи контейнера администрирования устройств
Rel(APIGateway, DevicesController, "Делает запросы управления устройствами")
Rel(DevicesController, DevicesService, "Вызывает бизнес-логику")
Rel(DevicesService, DevicesComponent, "Читает/записывает/удаляет данные об устройствах и управляет ими")
Rel(DevicesComponent, db, "Данные об устройствах")

Rel(APIGateway, FunctionalController, "Делает запросы управления функционалом устройств")
Rel(FunctionalController, FunctionalService, "Вызывает бизнес-логику")
Rel(FunctionalConsumer, FunctionalService, "Вызывает бизнес-логику")
Rel(FunctionalService, FunctionalComponent, "Читает/записывает/удаляет данные о функционале устройств и вызывает его срабатывание")
Rel(FunctionalComponent, UserDevicesSystem, "Запросы управления функционалом устройств")
Rel(FunctionalComponent, db, "Данные о функционале устройств")

' Связи контейнера администрирования модулей
Rel(APIGateway, ModulesController, "Делает запросы управления модулями")
Rel(ModulesController, ModulesService, "Вызывает бизнес-логику")
Rel(ModulesService, ModulesComponent, "Читает/записывает/удаляет данные о модулях")
Rel(ModulesComponent, db, "Данные о модулях")

Rel(APIGateway, ModulesConnectController, "Делает запросы связи устройств с модулями")
Rel(ModulesConnectController, ModulesConnectService, "Вызывает бизнес-логику")
Rel(ModulesConnectService, ModulesConnectComponent, "Читает/записывает/удаляет связи устройств с модулями")
Rel(ModulesConnectComponent, db, "Данные о связи устройств с модулями")

' Связи брокера
Rel(broker, FunctionalConsumer, "События вызова функционала устройств")

@endmul