@startuml Users component diagram
title Диаграмма компонентов управления пользователями

!include ../templates/C4_Component.puml

' Внешние сущности
Container(APIGateway, "API Gateway", "GoLang 1.22", "Обрабатывает запросы пользователей")
ContainerDb(db, "База данных", "PostgreSql 16", "Хранит информацию о пользователях, ролях и их связях")
ContainerDb(redis, "База данных", "Redis", "Хранит информацию о сессиях пользователей и кеши")

' Контейнер администрирования пользователей
Container_Boundary(UsersContainer, "Администрирование пользователей") {
    ' Управление учетными записями пользователей
    Component(UsersController, "Контроллер управления пользователями", "NestJS Rest Controller")
    Component(UsersService, "Сервис управления пользователями", "NestJS")
    Component(UsersComponent, "Компонент управления пользователями", "NestJS")

    ' Управление ролями
    Component(RolesController, "Контроллер управления ролями", "NestJS Rest Controller")
    Component(RolesService, "Сервис управления ролями", "NestJS")
    Component(RolesComponent, "Компонент управления ролями", "NestJS")

    ' Привязка ролей к пользователю
    Component(RolesConnectController, "Контроллер привязки ролей к пользователям", "NestJS Rest Controller")
    Component(RolesConnectService, "Сервис привязки ролей к пользователям", "NestJS")
    Component(RolesConnectComponent, "Компонент привязки ролей к пользователям", "NestJS")

    ' Управление авторизацией пользователя
    Component(AuthController, "Контроллер управления авторизацией пользователей", "NestJS Rest Controller")
    Component(AuthService, "Сервис управления авторизацией пользователей", "NestJS")
    Component(AuthComponent, "Компонент управления авторизацией пользователей", "NestJS")
}

' Связи
Rel(APIGateway, UsersController, "Делает запросы управления пользователями")
Rel(UsersController, UsersService, "Вызывает бизнес-логику")
Rel(UsersService, UsersComponent, "Читает/записывает/удаляет данные о пользователях")
Rel(UsersComponent, db, "Данные о пользователях")

Rel(APIGateway, RolesController, "Делает запросы управления ролями")
Rel(RolesController, RolesService, "Вызывает бизнес-логику")
Rel(RolesService, RolesComponent, "Читает/записывает/удаляет данные о ролях")
Rel(RolesComponent, db, "Данные о ролях")

Rel(APIGateway, RolesConnectController, "Делает запросы привязки ролей к пользователям")
Rel(RolesConnectController, RolesConnectService, "Вызывает бизнес-логику")
Rel(RolesConnectService, RolesConnectComponent, "Читает/записывает/удаляет данные о связях ролей с пользователями")
Rel(RolesConnectComponent, db, "Данные о связях ролей с пользователями")

' Связи управления авторизацией пользователя
Rel(APIGateway, AuthController, "Делает запросы авторизации пользователей")
Rel(AuthController, AuthService, "Вызывает бизнес-логику")
Rel(AuthService, AuthComponent, "Читает/записывает/удаляет данные об авторизации")
Rel(AuthComponent, redis, "Данные об авторизации")
Rel(AuthComponent, db, "Данные о пользователе и его ролях")

@endmul